# 华为云 API 密钥
# 在华为云控制台 -> 我的凭证 -> 访问密钥 中创建
HUAWEI_AK=你的AccessKey
HUAWEI_SK=你的SecretKey

# 飞书自定义机器人 Webhook 地址
# 飞书电脑端 -> 群设置 -> 添加机器人 -> 自定义机器人 -> 复制 Webhook 地址
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxx

# DNS 服务区域（默认 ap-southeast-1，华为云国际版）
# 可选: ap-southeast-1, cn-east-3, cn-north-1 等
HUAWEI_REGION=ap-southeast-1
